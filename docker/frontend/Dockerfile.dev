FROM node:22-alpine

WORKDIR /app

# Copy package descriptors
COPY package*.json ./

# Install npm dependencies
RUN npm install --legacy-peer-deps

# Copy application source
COPY . .

EXPOSE 5173

# Start Vite in development mode with HMR enabled on all interfaces
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
